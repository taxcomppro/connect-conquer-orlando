SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# EDC: server-only values. Never prefix these with VITE_ or NEXT_PUBLIC_.
EDC_SHOW_ID=
EDC_API_KEY=
EDC_API_URL=https://retrievemyleads.com/api/meta/1.1/read/

# Field Hub event and main-site handoff. The VITE_* URLs/IDs are browser-visible;
# secrets and database URLs are server-only.
VITE_FIELD_HUB_EVENT_ID=IRS-FORUM-ORLANDO-2026
VITE_TAX_COMP_PRO_JOIN_URL=https://www.taxcomppro.com/join
DATABASE_URL=
DIRECT_DATABASE_URL=
FIELD_HUB_MEMBERSHIP_WEBHOOK_SECRET=
TAX_COMP_PRO_MEMBERSHIP_STATUS_URL=
TAX_COMP_PRO_INTEGRATION_SECRET=

# Existing Tax Comp Pro ProConnect service: server-to-server event issuance.
# Keep this URL and the shared integration secret server-only (never VITE_*).
